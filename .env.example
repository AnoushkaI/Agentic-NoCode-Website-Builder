# =====================================================================
# SitePilot AI - LLM Provider Configuration
# Supported providers: nvidia, ollama, openai
# =====================================================================

# Active Provider: "nvidia" (default for prototype), "ollama" (local backup), or "openai"
LLM_PROVIDER=nvidia

# ---------------------------------------------------------------------
# Option 1: NVIDIA NIM (Primary Prototype Choice)
# Model: NVIDIA Nemotron 3.5 Bolt E4B or other NIM models
# Get your API key at: https://build.nvidia.com/
# ---------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# ---------------------------------------------------------------------
# Option 2: Ollama / Local Models (Backup Choice)
# Model: Qwen 2.5 3B (run `ollama run qwen2.5:3b`)
# Default Base URL: http://localhost:11434/v1
# ---------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_API_KEY=ollama

# ---------------------------------------------------------------------
# Option 3: OpenAI (Documentation / Benchmark Choice)
# Model: gpt-4o-mini or gpt-4o
# ---------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------
# General LLM Settings
# ---------------------------------------------------------------------
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2
